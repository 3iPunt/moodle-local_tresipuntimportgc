{{!
  @template local_tresipuntimportgc/setting_connection

  Connection status block (C10) inside the plugin settings page: state badge,
  copiable redirect URI and test link.

  Context variables required for this template:
  * configured - whether client id + secret are set
  * redirecturi - exact redirect URI to register in Google Cloud
  * testurl - URL that triggers the real OAuth flow

  Example context (json):
  {
    "configured": false,
    "redirecturi": "https://example.com/local/tresipuntimportgc/import.php",
    "testurl": "#"
  }
}}
<div class="local-tipgc tipgc-setting-connection" data-region="tipgc-setting-connection">
    <div class="tipgc-card p-3 mb-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap mb-2">
            <span class="tipgc-label m-0">{{# str }} connectionstatus, local_tresipuntimportgc {{/ str }}</span>
            {{# configured }}
                <span class="tipgc-badge tipgc-badge-success">{{# str }} conn_configured, local_tresipuntimportgc {{/ str }}</span>
            {{/ configured }}
            {{^ configured }}
                <span class="tipgc-badge tipgc-badge-error">{{# str }} conn_incomplete, local_tresipuntimportgc {{/ str }}</span>
            {{/ configured }}
        </div>
        <label class="tipgc-label" for="tipgc-redirecturi">{{# str }} redirecturi, local_tresipuntimportgc {{/ str }}</label>
        <div class="d-flex tipgc-uri-row">
            <code id="tipgc-redirecturi" class="tipgc-uri flex-grow-1">{{ redirecturi }}</code>
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-action="tipgc-copy-uri" data-uri="{{ redirecturi }}">
                {{# str }} copyuri, local_tresipuntimportgc {{/ str }}
            </button>
        </div>
        <div class="small mt-1 tipgc-copy-feedback" data-region="copy-feedback" aria-live="polite"></div>
        <div class="tipgc-testrow d-flex align-items-center flex-wrap mt-2">
            <a class="btn btn-outline-secondary btn-sm" href="{{ testurl }}">
                {{# str }} testconnection, local_tresipuntimportgc {{/ str }}
            </a>
            <span class="text-muted small">{{# str }} testconnection_note, local_tresipuntimportgc {{/ str }}</span>
        </div>
    </div>
</div>
{{#js}}
require(['core/str', 'core/notification'], function(Str, Notification) {
    var button = document.querySelector('[data-action="tipgc-copy-uri"]');
    if (!button) {
        return;
    }
    // navigator.clipboard solo existe en contextos seguros (certificado
    // válido): en entornos locales con certificado autofirmado se usa el
    // fallback clásico de selección + execCommand.
    var copy = function(text) {
        if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(text);
        }
        var area = document.createElement('textarea');
        area.value = text;
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        document.execCommand('copy');
        document.body.removeChild(area);
        return Promise.resolve();
    };
    button.addEventListener('click', function() {
        copy(button.getAttribute('data-uri')).then(function() {
            return Str.get_string('uricopied', 'local_tresipuntimportgc');
        }).then(function(s) {
            document.querySelector('[data-region="copy-feedback"]').textContent = s;
            return s;
        }).catch(Notification.exception);
    });
});
{{/js}}
