{{!
  @template local_tresipuntimportgc/components/page_header

  Co-branded page header (C11): Tresipunt + Google Classroom marks on the
  left block, bold title with optional status badge and muted description on
  the right block.

  Context variables required for this template:
  * logotresipunt - URL of the Tresipunt horizontal logo (pix)
  * logotresipunticon - URL of the Tresipunt square icon (pix)
  * logoclassroom - URL of the Classroom isotype (pix)
  * title - page title
  * description - one-line muted description
  * hasstatus - whether to show the status badge
  * statuslabel - badge text
  * statusclass - badge modifier class (tipgc-badge-*)

  Example context (json):
  {
    "logotresipunt": "#", "logotresipunticon": "#", "logoclassroom": "#",
    "title": "Importar cursos de Google Classroom",
    "description": "Elige las clases y su configuración.",
    "hasstatus": false, "statuslabel": "", "statusclass": ""
  }
}}
<div class="tipgc-header d-flex flex-wrap align-items-stretch">
    <div class="tipgc-header-brands d-flex align-items-center">
        <img src="{{ logotresipunt }}" alt="Tresipunt" class="tipgc-logo-full" height="42">
        <img src="{{ logotresipunticon }}" alt="Tresipunt" class="tipgc-logo-mark" height="42">
        <span class="tipgc-header-divider" aria-hidden="true"></span>
        <img src="{{ logoclassroom }}" alt="Google Classroom" height="42">
    </div>
    <div class="tipgc-header-text d-flex flex-column justify-content-center">
        <div class="tipgc-titlerow d-flex align-items-center flex-wrap">
            <h1 class="tipgc-header-title h2 m-0">{{ title }}</h1>
            {{# hasstatus }}
                <span class="tipgc-badge {{ statusclass }}">{{ statuslabel }}</span>
            {{/ hasstatus }}
        </div>
        <p class="tipgc-header-desc m-0">{{ description }}</p>
    </div>
</div>
